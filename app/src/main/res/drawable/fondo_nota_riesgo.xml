<?xml version="1.0" encoding="utf-8"?>
<!--
  Casilla de una nota en riesgo o perdida (planillas) y etiqueta "en rojo" del Inicio:
  degradado coral, como "Llevas" en la Bienvenida. Es bastante más oscura que la verde
  (fondo_nota_aprobada.xml), así que las dos no se distinguen solo por el tono (RNF-05).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:angle="315" android:startColor="@color/riesgo_vivo" android:endColor="#FDB4BD" />
    <corners android:radius="8dp" />
</shape>
