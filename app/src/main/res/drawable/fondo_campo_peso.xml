<?xml version="1.0" encoding="utf-8"?>
<!-- Recuadro del % de cada nota en "Con porcentajes": relleno suave, borde azul al escribir -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/fondo" />
            <corners android:radius="@dimen/radio_campo" />
            <stroke android:width="@dimen/borde_grueso" android:color="@color/acento_oscuro" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/fondo" />
            <corners android:radius="@dimen/radio_campo" />
        </shape>
    </item>
</selector>
