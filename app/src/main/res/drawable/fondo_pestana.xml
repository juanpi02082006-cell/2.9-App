<?xml version="1.0" encoding="utf-8"?>
<!--
  Pestaña de la barra inferior: activa con fondo azul suave.
  Va envuelto en un ripple para que el toque se sienta; antes era solo un selector
  de formas y la pestaña no daba ninguna señal al tocarla.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/azul_oscuro">

    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@color/blanco" />
            <corners android:radius="@dimen/radio_boton" />
        </shape>
    </item>

    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/azul_suave" />
                    <corners android:radius="@dimen/radio_boton" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <corners android:radius="@dimen/radio_boton" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
