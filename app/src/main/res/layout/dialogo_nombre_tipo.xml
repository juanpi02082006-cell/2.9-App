<?xml version="1.0" encoding="utf-8"?>
<!-- Nombre de un tipo de nota nuevo, en la pantalla 07 Forma de calificar -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="24dp"
    android:paddingTop="@dimen/espacio_s"
    android:paddingEnd="24dp">

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Estilo.Campo.SobreBlanco"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/nombreTipo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/forma_tipo_nuevo_pista"
            android:inputType="textCapSentences"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>
</FrameLayout>
