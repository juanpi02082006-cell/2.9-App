<?xml version="1.0" encoding="utf-8"?>
<!-- Opción con chevron del Perfil (pantalla 12). El texto se pone desde Java. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/fondo_fila_pulsable"
    android:gravity="center_vertical"
    android:minHeight="@dimen/area_tactil_min"
    android:orientation="horizontal"
    android:paddingStart="@dimen/espacio_l"
    android:paddingTop="@dimen/espacio_m"
    android:paddingEnd="@dimen/espacio_l"
    android:paddingBottom="@dimen/espacio_m">

    <ImageView
        android:id="@+id/icono"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:importantForAccessibility="no"
        app:tint="@color/texto_secundario"
        tools:src="@drawable/ic_calendario" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/espacio_m"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/titulo"
            style="@style/Texto.Principal.Medio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Forma de calificar" />

        <TextView
            android:id="@+id/detalle"
            style="@style/Texto.Apoyo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:text="Cortes, tipos de nota y nota para pasar"
            tools:visibility="visible" />
    </LinearLayout>

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_derecha"
        app:tint="@color/borde_punteado" />
</LinearLayout>
