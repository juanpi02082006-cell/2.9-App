<?xml version="1.0" encoding="utf-8"?>
<!--
  02 Entrar · 25 Error al entrar (doc 03, RF-03, RF-04 y RF-06).

  Se entra con correo O con nombre de usuario, en el mismo campo: si lo escrito
  lleva @ es un correo, si no se busca en la colección usernames (doc 06 · 4).

  El botón de Google va con fondo neutro y el logo oficial, según las guías de marca
  de Google: su logo nunca puede ir sobre el naranja de la app.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:background="@color/fondo"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:paddingStart="@dimen/margen_pantalla"
        android:paddingEnd="@dimen/margen_pantalla"
        android:paddingBottom="@dimen/espacio_xl">

        <ImageView
            android:id="@+id/botonVolver"
            style="@style/Estilo.BotonCircular"
            android:layout_marginTop="@dimen/espacio_xl"
            android:contentDescription="@string/desc_volver"
            android:src="@drawable/ic_chevron_izquierda"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/tinta" />

        <!-- ===== Marca ===== -->
        <ImageView
            android:id="@+id/icono"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="@dimen/espacio_xl"
            android:contentDescription="@string/desc_logo"
            android:src="@mipmap/ic_launcher"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/botonVolver" />

        <TextView
            android:id="@+id/titulo"
            style="@style/Texto.Titulo.Pequeno"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_l"
            android:accessibilityHeading="true"
            android:text="@string/entrar_titulo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/icono" />

        <!-- ===== Campos ===== -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/campoIdentificador"
            style="@style/Estilo.Campo.ConIcono"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/titulo"
            app:startIconDrawable="@drawable/ic_usuario_linea">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/identificador"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="username"
                android:hint="@string/entrar_identificador"
                android:imeOptions="actionNext"
                android:inputType="textEmailAddress"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/campoContrasena"
            style="@style/Estilo.Campo.ConIcono"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_m"
            app:endIconDrawable="@drawable/ic_ojo"
            app:endIconMode="password_toggle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/campoIdentificador"
            app:startIconDrawable="@drawable/ic_candado_linea">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/contrasena"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="password"
                android:hint="@string/entrar_contrasena"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ===== 25 Error al entrar (RF-06) ===== -->
        <LinearLayout
            android:id="@+id/bloqueError"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_m"
            android:background="@drawable/fondo_error"
            android:orientation="horizontal"
            android:padding="@dimen/espacio_l"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/campoContrasena"
            tools:visibility="visible">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_alerta"
                app:tint="@color/reprobado" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/espacio_s"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/errorTitulo"
                    style="@style/Texto.Etiqueta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/reprobado"
                    tools:text="@string/entrar_error_credenciales" />

                <TextView
                    android:id="@+id/errorDetalle"
                    style="@style/Texto.Apoyo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/reprobado"
                    tools:text="@string/entrar_error_credenciales_detalle" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonEntrar"
            style="@style/Estilo.Boton.Principal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_l"
            android:text="@string/entrar_boton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/bloqueError" />

        <ProgressBar
            android:id="@+id/cargando"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:indeterminateTint="@color/tinta"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/botonEntrar"
            app:layout_constraintEnd_toEndOf="@id/botonEntrar"
            app:layout_constraintStart_toStartOf="@id/botonEntrar"
            app:layout_constraintTop_toTopOf="@id/botonEntrar" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonOlvide"
            style="@style/Estilo.Boton.Enlace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_s"
            android:text="@string/entrar_olvidaste"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/botonEntrar" />

        <!-- ===== Separador "o" ===== -->
        <View
            android:id="@+id/lineaIzquierda"
            android:layout_width="0dp"
            android:layout_height="@dimen/borde_fino"
            android:layout_marginEnd="@dimen/espacio_l"
            android:background="@color/borde"
            app:layout_constraintBottom_toBottomOf="@id/separadorO"
            app:layout_constraintEnd_toStartOf="@id/separadorO"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/separadorO" />

        <TextView
            android:id="@+id/separadorO"
            style="@style/Texto.Apoyo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_l"
            android:text="@string/entrar_o"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/botonOlvide" />

        <View
            android:id="@+id/lineaDerecha"
            android:layout_width="0dp"
            android:layout_height="@dimen/borde_fino"
            android:layout_marginStart="@dimen/espacio_l"
            android:background="@color/borde"
            app:layout_constraintBottom_toBottomOf="@id/separadorO"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/separadorO"
            app:layout_constraintTop_toTopOf="@id/separadorO" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonGoogle"
            style="@style/Estilo.Boton.Google"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_l"
            android:text="@string/entrar_google"
            app:icon="@drawable/ic_google"
            app:iconGravity="textStart"
            app:iconTint="@null"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/separadorO" />

        <!-- ===== Pie ===== -->
        <LinearLayout
            android:id="@+id/pie"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/botonGoogle"
            app:layout_constraintVertical_bias="1">

            <TextView
                style="@style/Texto.Apoyo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/entrar_sin_cuenta"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonCrearCuenta"
                style="@style/Estilo.Boton.Enlace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingStart="@dimen/espacio_s"
                android:paddingEnd="@dimen/espacio_s"
                android:text="@string/entrar_crear" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
