<?xml version="1.0" encoding="utf-8"?>
<!-- Una opción de la hoja "Elige tu foto": foto de Google, uno de los 8 avatares o iniciales -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="56dp"
    android:layout_height="56dp"
    android:layout_gravity="center"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/iniciales"
        style="@style/Texto.Principal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/fondo_avatar"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textColor="@color/tinta" />

    <ImageView
        android:id="@+id/foto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <!-- La escogida lleva anillo -->
    <View
        android:id="@+id/anillo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/anillo_avatar"
        android:visibility="gone" />
</FrameLayout>
