<?xml version="1.0" encoding="utf-8"?>
<!--
  Un tipo de nota con su peso debajo (boceto 09). Ver el porcentaje aquí evita tener
  que ir a la forma de calificar para saber cuánto pesa lo que estás registrando.

  Cada chip mide lo que su nombre y el espacio sobrante se reparte por igual (ancho
  wrap_content con peso 1): con anchos iguales, "Trabajo o quiz" salía cortado.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:background="@drawable/fondo_chip_tipo"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:minHeight="@dimen/alto_chip_tipo"
    android:orientation="vertical"
    android:paddingStart="@dimen/espacio_s"
    android:paddingTop="@dimen/espacio_m"
    android:paddingEnd="@dimen/espacio_s"
    android:paddingBottom="@dimen/espacio_m">

    <TextView
        android:id="@+id/nombre"
        style="@style/Texto.Principal.Medio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/texto_chip_tipo"
        tools:text="Trabajo o quiz" />

    <TextView
        android:id="@+id/porcentaje"
        style="@style/Texto.Apoyo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/texto_chip_tipo_apoyo"
        tools:text="30%" />
</LinearLayout>
