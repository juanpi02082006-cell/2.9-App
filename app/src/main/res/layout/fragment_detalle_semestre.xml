<?xml version="1.0" encoding="utf-8"?>
<!--
  23 Detalle de semestre (doc 03, RF-26).
  Promedio del semestre y planilla con la definitiva de cada materia.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/botonVolver"
        style="@style/Estilo.BotonIcono"
        android:layout_marginStart="@dimen/espacio_s"
        android:layout_marginTop="@dimen/espacio_m"
        android:contentDescription="@string/desc_volver"
        app:icon="@drawable/ic_volver"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="@dimen/margen_pantalla"
        android:paddingEnd="@dimen/margen_pantalla"
        android:paddingBottom="@dimen/espacio_l"
        app:layout_constraintBottom_toTopOf="@id/botonEditarFinales"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/botonVolver">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/periodo"
                style="@style/Texto.Titulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="2025-1" />

            <TextView
                android:id="@+id/detalle"
                style="@style/Texto.Apoyo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="5 materias · 16 créditos · Terminado" />

            <TextView
                style="@style/Texto.Apoyo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_xl"
                android:text="@string/semestre_promedio" />

            <TextView
                android:id="@+id/promedio"
                style="@style/Texto.NumeroGigante"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="3.5" />

            <!-- Planilla de definitivas -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Estilo.Planilla"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_l">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/encabezado"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/planilla_sangria"
                        android:paddingTop="@dimen/espacio_m"
                        android:paddingEnd="@dimen/espacio_l"
                        android:paddingBottom="@dimen/espacio_s"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            style="@style/Texto.EncabezadoPlanilla"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/planilla_materia" />

                        <TextView
                            android:id="@+id/encabezadoNota"
                            style="@style/Texto.EncabezadoPlanilla"
                            android:layout_width="@dimen/col_definitiva"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="@string/planilla_definitiva" />
                    </LinearLayout>

                    <View
                        android:id="@+id/divisorEncabezado"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/borde_fino"
                        android:background="@color/borde_suave"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/encabezado" />

                    <LinearLayout
                        android:id="@+id/listaMaterias"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/divisorEncabezado" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/botonEditarFinales"
        style="@style/Estilo.Boton.Secundario"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margen_pantalla"
        android:layout_marginEnd="@dimen/margen_pantalla"
        android:layout_marginBottom="@dimen/espacio_xl"
        android:text="@string/semestre_editar_finales"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
