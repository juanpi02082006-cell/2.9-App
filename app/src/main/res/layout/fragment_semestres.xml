<?xml version="1.0" encoding="utf-8"?>
<!--
  10 Semestres (doc 03, RF-24).
  Promedio acumulado (solo semestres terminados, RN-11), gráfica de barras con la
  línea del 3.0 y la lista de semestres. La gráfica se arma con pesos, sin librerías.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:background="@color/fondo"
    android:clipToPadding="false"
    android:paddingBottom="@dimen/espacio_bajo_barra_nav">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/margen_pantalla"
        android:paddingTop="32dp"
        android:paddingEnd="@dimen/margen_pantalla">

        <TextView
            style="@style/Texto.Titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/semestres_titulo" />

        <!-- ===== Promedio acumulado de la carrera ===== -->
        <TextView
            style="@style/Texto.Apoyo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_xl"
            android:text="@string/semestres_acumulado" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/acumulado"
                style="@style/Texto.NumeroGigante"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="3.5" />

            <TextView
                android:id="@+id/acumuladoDetalle"
                style="@style/Texto.Apoyo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginStart="@dimen/espacio_m"
                android:layout_marginBottom="@dimen/espacio_m"
                android:layout_weight="1"
                tools:text="16 créditos aprobados" />
        </LinearLayout>

        <!-- ===== Gráfica por semestre ===== -->
        <TextView
            style="@style/Texto.EncabezadoPlanilla"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_l"
            android:text="@string/semestres_grafica" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Estilo.Planilla"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_s">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/desc_grafica_semestres"
                android:padding="@dimen/espacio_l">

                <!-- Las barras: una columna por semestre, altura proporcional -->
                <LinearLayout
                    android:id="@+id/grafica"
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toStartOf="@id/etiquetaTres"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Línea del 3.0: queda al 60 % de la escala de 0 a 5 -->
                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guiaTres"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintGuide_percent="0.4" />

                <!--
                  Baja la franja del valor (alto_valor_barra) que llevan todas las columnas
                  encima de la barra; el 0.4 se mide en lo que queda de alto
                -->
                <View
                    android:id="@+id/lineaTres"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/borde_fino"
                    android:layout_marginTop="@dimen/alto_valor_barra"
                    android:background="@color/acento_oscuro"
                    app:layout_constraintBottom_toBottomOf="@id/grafica"
                    app:layout_constraintEnd_toEndOf="@id/grafica"
                    app:layout_constraintStart_toStartOf="@id/grafica"
                    app:layout_constraintTop_toTopOf="@id/grafica"
                    app:layout_constraintVertical_bias="0.4" />

                <TextView
                    android:id="@+id/etiquetaTres"
                    style="@style/Texto.Apoyo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espacio_xs"
                    android:text="@string/semestres_linea_tres"
                    android:textColor="@color/acento_oscuro"
                    app:layout_constraintBottom_toBottomOf="@id/lineaTres"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/lineaTres" />

                <LinearLayout
                    android:id="@+id/etiquetasGrafica"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_s"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="@id/grafica"
                    app:layout_constraintStart_toStartOf="@id/grafica"
                    app:layout_constraintTop_toBottomOf="@id/grafica" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== Lista de semestres ===== -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listaSemestres"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_l"
            android:nestedScrollingEnabled="false"
            tools:itemCount="3"
            tools:listitem="@layout/item_semestre" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonSemestreAnterior"
            style="@style/Estilo.Boton.Secundario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_m"
            android:text="@string/semestres_agregar_anterior" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
