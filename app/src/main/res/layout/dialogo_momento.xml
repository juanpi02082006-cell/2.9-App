<?xml version="1.0" encoding="utf-8"?>
<!--
  Momento: al cerrar un corte o el semestre. Una tarjeta sube desde abajo con la nota
  enorme (cuenta desde 0.0), un sello cae girado y "golpea" y, si se celebra, estalla el
  confeti desde el sello. Si no pasó, va en azul tranquilo y con el plan concreto.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/velo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/velo_dialogo" />

    <LinearLayout
        android:id="@+id/tarjeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="@dimen/margen_pantalla"
        android:layout_marginEnd="@dimen/margen_pantalla"
        android:layout_marginBottom="40dp"
        android:background="@drawable/fondo_tarjeta"
        android:clickable="true"
        android:elevation="8dp"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingStart="@dimen/espacio_xl"
        android:paddingTop="@dimen/espacio_xl"
        android:paddingEnd="@dimen/espacio_xl"
        android:paddingBottom="@dimen/espacio_xl">

        <TextView
            android:id="@+id/etiqueta"
            style="@style/Texto.Apoyo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Corte 2 · Cálculo II" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false">

            <TextView
                android:id="@+id/nota"
                style="@style/Texto.NumeroGrande"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="80sp"
                tools:text="4.8" />

            <TextView
                android:id="@+id/sello"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:fontFamily="@font/dmsans_semibold"
                android:letterSpacing="0.12"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="14dp"
                android:paddingBottom="6dp"
                android:rotation="-12"
                android:textSize="20sp"
                tools:text="DE LUJO" />
        </FrameLayout>

        <!-- Solo en el semestre -->
        <TextView
            android:id="@+id/aprobadas"
            style="@style/Texto.Principal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:text="5 de 6 materias aprobadas"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/mejor"
            style="@style/Texto.Apoyo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_xs"
            android:visibility="gone"
            tools:text="Tu mejor materia: Física I · 4.6"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/mensaje"
            style="@style/Texto.Principal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_l"
            android:textSize="18sp"
            tools:text="4.8 en Cálculo II. Eso no es una nota, es un mensaje para el profe." />

        <TextView
            android:id="@+id/plan"
            style="@style/Texto.Apoyo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_m"
            android:paddingStart="@dimen/espacio_m"
            android:paddingTop="@dimen/espacio_s"
            android:paddingEnd="@dimen/espacio_m"
            android:paddingBottom="@dimen/espacio_s"
            android:textColor="@color/tinta"
            tools:text="Llevas 4.3 en la materia" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonSeguir"
            style="@style/Estilo.Boton.Principal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_xl"
            android:text="@string/momento_seguir" />
    </LinearLayout>

    <!-- Encima de todo: el confeti cae también sobre la tarjeta -->
    <com.dosnueve.app.ui.momento.ConfetiView
        android:id="@+id/confeti"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
