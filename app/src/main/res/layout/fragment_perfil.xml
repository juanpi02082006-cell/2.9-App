<?xml version="1.0" encoding="utf-8"?>
<!--
  12 Perfil (doc 03, RF-05, RF-28 y RF-29).
  Datos de la cuenta de Google, forma de calificar, fechas, avisos y cerrar sesión.
  Exportar a PDF (RF-30) se quitó el 2026-11-16: no hacía falta.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:background="@color/fondo"
    android:clipToPadding="false"
    android:paddingBottom="@dimen/espacio_bajo_barra_nav">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/margen_pantalla"
        android:paddingTop="32dp"
        android:paddingEnd="@dimen/margen_pantalla">

        <TextView
            style="@style/Texto.Titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/perfil_titulo" />

        <!-- ===== Cuenta de Google (RF-02) ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_l"
            android:background="@drawable/fondo_seccion"
            android:elevation="@dimen/elevacion_tarjeta"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/espacio_l">

            <!-- Tocarlo abre "Elige tu foto": foto de Google, avatar o iniciales -->
            <FrameLayout
                android:id="@+id/avatarPerfil"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/perfil_cambiar_foto"
                android:focusable="true">

                <TextView
                    android:id="@+id/iniciales"
                    style="@style/Texto.Titulo.Pequeno"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/fondo_avatar"
                    android:gravity="center"
                    android:textColor="@color/tinta"
                    tools:text="JM" />

                <ImageView
                    android:id="@+id/foto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/fondo_insignia"
                    android:importantForAccessibility="no"
                    android:padding="4dp"
                    android:src="@drawable/ic_lapiz"
                    app:tint="@color/blanco" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/espacio_l"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/nombre"
                    style="@style/Texto.Principal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    tools:text="Juanma" />

                <TextView
                    android:id="@+id/correo"
                    style="@style/Texto.Apoyo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    tools:text="juanma@gmail.com" />

                <TextView
                    android:id="@+id/universidad"
                    style="@style/Texto.Apoyo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    tools:text="Universidad de Antioquia" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== Configuración ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_l"
            android:background="@drawable/fondo_seccion"
            android:elevation="@dimen/elevacion_tarjeta"
            android:orientation="vertical">

            <include
                android:id="@+id/opcionFormaCalificar"
                layout="@layout/item_opcion_perfil" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/borde_fino"
                android:background="@color/borde_suave" />

            <include
                android:id="@+id/opcionFechas"
                layout="@layout/item_opcion_perfil" />
        </LinearLayout>

        <!-- ===== Avisos (RF-28, RF-29) ===== -->
        <TextView
            style="@style/Texto.EncabezadoPlanilla"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_xl"
            android:text="@string/perfil_avisos" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_s"
            android:background="@drawable/fondo_seccion"
            android:elevation="@dimen/elevacion_tarjeta"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/area_tactil_min"
                android:orientation="horizontal"
                android:paddingStart="@dimen/espacio_l"
                android:paddingTop="@dimen/espacio_m"
                android:paddingEnd="@dimen/espacio_m"
                android:paddingBottom="@dimen/espacio_m">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Texto.Principal.Medio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/perfil_recordar_notas" />

                    <TextView
                        style="@style/Texto.Apoyo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/perfil_recordar_notas_detalle" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/interruptorRecordar"
                    style="@style/Estilo.Interruptor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/borde_fino"
                android:background="@color/borde_suave" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/area_tactil_min"
                android:orientation="horizontal"
                android:paddingStart="@dimen/espacio_l"
                android:paddingTop="@dimen/espacio_m"
                android:paddingEnd="@dimen/espacio_m"
                android:paddingBottom="@dimen/espacio_m">

                <TextView
                    style="@style/Texto.Principal.Medio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/perfil_alerta_riesgo" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/interruptorRiesgo"
                    style="@style/Estilo.Interruptor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonCerrarSesion"
            style="@style/Estilo.Boton.Secundario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_xl"
            android:text="@string/perfil_cerrar_sesion"
            app:icon="@drawable/ic_salir"
            app:iconGravity="textStart" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
